+    S.Diag(AL.getLoc(), S.getDiagnostics().getCustomDiagID(
+        DiagnosticsEngine::Error, "user attribute requires a distinct locnN semantic"));
+    return;
+  }
+  D->addAttr(::new (S.Context) MetalUserVaryingAttr(S.Context, AL, Semantic));
+}
