{
  "name": "d2r-mobile-browser-preflight",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run lint && npm run format:check && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:docs": "prettier --write ../docs/WEB_IPA_PACKAGER.md ../docs/WEB_DELIVERY_PROGRESS.md",
    "format:docs:check": "prettier --check ../docs/WEB_IPA_PACKAGER.md ../docs/WEB_DELIVERY_PROGRESS.md"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "radix-ui": "1.4.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.13",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "@eslint/js": "9.36.0",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.48.0"
  }
}
