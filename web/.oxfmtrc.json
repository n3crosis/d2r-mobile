{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "coverage/",
    "**/bin/",
    "**/obj/",
    "**/_framework/",
    "SHADCN_LICENSE.md",
    "vendor/spark-md5-3.0.2/spark-md5.mjs",
    "vendor/spark-md5-3.0.2/LICENSE2",
    "toolchain/**/dist/",
    "toolchain/**/.build/",
    "toolchain/zsign-wasm/bounded-map.inc",
    "toolchain/zsign-wasm/stream-sha.inc",
    "toolchain/program-rewrite-spike/deps/",
    "toolchain/asset-generation-spike/public/generated/",
    "toolchain/asset-generation-spike/public/vendor/",
    "toolchain/spirv-cross-spike/wwwroot/spirv-cross.mjs",
    "bun.lock",
    "toolchain/**/package-lock.json",
    "runtime-build/.build/**",
    "runtime-build/out/**",
    "i18n-catalog.mjs"
  ]
}
